# ------------------------------------------------------------
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Local package caches
.npm/
.pnpm-store/

# ------------------------------------------------------------
