# ------------------------------------------------------------
/.next/
/out/
/build/
/dist/
/.turbo/

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------
# 3. Environment variables and secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local credentials
credentials.json
service-account*.json
service-role*.json
*.credentials.local.json

# ------------------------------------------------------------
# 4. Supabase local development
# ------------------------------------------------------------
.supabase/
supabase/.branches/
supabase/.temp/

# IMPORTANT:
# Keep supabase/migrations/ tracked.
# Keep supabase/config.toml tracked where appropriate.
# Keep sql/ migration files tracked.

# ------------------------------------------------------------
# 5. Tests and coverage
# ------------------------------------------------------------
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/

# ------------------------------------------------------------
# 6. Local logs and debugging
# ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Crash reports
*.stackdump
*.heapsnapshot
*.heapprofile

# ------------------------------------------------------------
# 7. Vercel local configuration
# ------------------------------------------------------------
.vercel/

# ------------------------------------------------------------
# 8. Operating system files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# ------------------------------------------------------------
# 9. Local IDE configuration
# ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ------------------------------------------------------------
# 10. Temporary generated files
# ------------------------------------------------------------
.tmp/
.temp/
tmp/
temp/

*.tmp
*.temp
*.bak
*.orig
*.rej

# ------------------------------------------------------------
# 11. Local runtime artifacts
# ------------------------------------------------------------
*.pid
*.pid.lock

# ------------------------------------------------------------
# 12. IMPORTANT FILES TO KEEP TRACKED
# ------------------------------------------------------------
# package.json
# package-lock.json
# next.config.ts
# eslint.config.mjs
# eslint-suppressions.json
# tsconfig.json
# postcss.config.mjs
# tailwind.config.ts
# src/app/globals.css
# src/app/layout.tsx
# supabase/migrations/
# sql/
# public/
# .env.example

# Do not globally ignore source code, migrations,
# SQL scripts, public assets, or application tests.
