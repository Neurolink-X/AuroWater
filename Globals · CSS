/**
 * AuroTap — src/app/globals.css
 * Tailwind CSS v4 + existing Tailwind config compatibility.
 * Fonts are loaded by src/app/layout.tsx using next/font/google.
 * Preserve existing design tokens and legacy utilities during migration.
 */
@import "tailwindcss";

/* Keep legacy custom utilities (font-body, text-fluid-*, glass, etc.).
   Path assumes this stylesheet is src/app/globals.css. */
@config "../../tailwind.config.ts";

/* Class-based dark mode (html.dark). */
@custom-variant dark (&:where(.dark, .dark *));

@theme inline {
  --color-primary: var(--primary);
  --color-primary-light: var(--primary-light);
  --color-primary-dark: var(--primary-dark);
  --color-accent: var(--accent);
  --color-accent-light: var(--accent-light);
  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --color-surface-3: var(--surface-3);
  --color-card: var(--card);
  --color-card-hover: var(--card-hover);
  --color-text: var(--text);
  --color-text-2: var(--text-2);
  --color-muted: var(--muted);
  --color-subtle: var(--subtle);
  --color-danger: var(--danger);
  --color-danger-light: var(--danger-light);
  --color-warning: var(--warning);
  --color-warning-light: var(--warning-light);
  --color-success: var(--success);
  --color-success-light: var(--success-light);
  --color-info: var(--info);
  --color-info-light: var(--info-light);
  --color-border: var(--border);
  --color-border-2: var(--border-2);
  --color-footer: var(--footer-bg);
  --color-footerBg: var(--footer-bg); /* legacy class compatibility */
  --color-overlay: var(--overlay);

  --font-sans: var(--font-jakarta), var(--font-devanagari), system-ui, sans-serif;
  --font-body: var(--font-jakarta), var(--font-devanagari), system-ui, sans-serif;
  --font-ui: var(--font-jakarta), system-ui, sans-serif;
  --font-display: var(--font-bricolage), var(--font-jakarta), system-ui, sans-serif;
  --font-brand: var(--font-syne), var(--font-jakarta), system-ui, sans-serif;
  --font-kpi: var(--font-syne), system-ui, sans-serif;
  /* --font-devanagari is owned by next/font; do not overwrite it. */
  --font-mono: var(--font-jetbrains), ui-monospace, monospace;
  --font-code: var(--font-jetbrains), ui-monospace, monospace;

  /* Alias different source names to avoid self-referential shadow tokens. */
  --shadow-card: var(--elevation-card);
  --shadow-float: var(--elevation-float);
  --radius-card: 1rem;
  --radius-pill: 999px;
}

:root {
  color-scheme: light;
  --primary: #0ea5e9;
  --primary-light: #38bdf8;
  --primary-dark: #0284c7;
  --accent: #2563eb;
  --accent-light: #3b82f6;
  --surface: #f0f6ff;
  --surface-2: #e8f1ff;
  --surface-3: #dbeafe;
  --card: #ffffff;
  --card-hover: #f8fafc;
  --text: #0a1628;
  --text-2: #1e3a5f;
  --muted: #64748b;
  --subtle: #94a3b8;
  --danger: #ef4444;
  --danger-light: #fef2f2;
  --warning: #f59e0b;
  --warning-light: #fffbeb;
  --success: #22c55e;
  --success-light: #f0fdf4;
  --info: #0ea5e9;
  --info-light: #f0f9ff;
  --border: rgba(14, 165, 233, 0.15);
  --border-2: rgba(14, 165, 233, 0.25);
  --footer-bg: #0a1628;
  --overlay: rgba(10, 23, 48, 0.55);
  --elevation-card: 0 1px 2px rgba(10, 22, 40, 0.05), 0 4px 16px rgba(14, 165, 233, 0.08);
  --elevation-float: 0 8px 32px rgba(10, 22, 40, 0.14);
  --skeleton-base: #e2ecf9;
  --skeleton-shine: #f4f8ff;
}

.dark {
  color-scheme: dark;
  --primary: #38bdf8;
  --primary-light: #7dd3fc;
  --primary-dark: #0ea5e9;
  --accent: #60a5fa;
  --accent-light: #93c5fd;
  --surface: #020d1a;
  --surface-2: #051830;
  --surface-3: #0a2744;
  --card: #0a2744;
  --card-hover: #0e2f52;
  --text: #e0f2fe;
  --text-2: #bae6fd;
  --muted: #7dd3fc;
  --subtle: #64748b;
  --danger: #f87171;
  --danger-light: rgba(239, 68, 68, 0.12);
  --warning: #fcd34d;
  --warning-light: rgba(245, 158, 11, 0.12);
  --success: #4ade80;
  --success-light: rgba(34, 197, 94, 0.12);
  --info: #38bdf8;
  --info-light: rgba(14, 165, 233, 0.12);
  --border: rgba(14, 165, 233, 0.18);
  --border-2: rgba(14, 165, 233, 0.3);
  --footer-bg: #020d1a;
  --overlay: rgba(2, 13, 26, 0.75);
  --elevation-card: 0 1px 2px rgba(0, 0, 0, 0.4), 0 4px 16px rgba(0, 0, 0, 0.3);
  --elevation-float: 0 8px 32px rgba(0, 0, 0, 0.55);
  --skeleton-base: #0a2744;
  --skeleton-shine: #12365e;
}

@layer base {
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-padding-top: 5rem;
    -webkit-tap-highlight-color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
  body {
    font-family: var(--font-jakarta), var(--font-devanagari), system-ui, sans-serif;
    background-color: var(--surface);
    color: var(--text);
    line-height: 1.6;
    min-height: 100dvh;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: clip;
  }
  h1, h2, h3 { text-wrap: balance; }
  p { text-wrap: pretty; }
  ::selection {
    background: color-mix(in srgb, var(--primary) 30%, transparent);
    color: inherit;
  }
  button:not(:disabled), [role="button"]:not([aria-disabled="true"]) { cursor: pointer; }
  button:disabled, [aria-disabled="true"] { cursor: not-allowed; }
  /* Keep desktop form control typography unchanged. Prevent iOS input zoom on small touch screens. */
  @media (max-width: 767px) and (pointer: coarse) {
    input, select, textarea { font-size: max(16px, 1em); }
  }
  ::placeholder { color: var(--subtle); opacity: 1; }
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  input[type="number"] { -moz-appearance: textfield; appearance: textfield; }
  :focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }
  :focus:not(:focus-visible) { outline: none; }
  * { scrollbar-width: thin; scrollbar-color: var(--border-2) transparent; }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 999px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--primary); }
}

@utility skeleton {
  background-color: var(--skeleton-base);
  background-image: linear-gradient(90deg, transparent 0%, var(--skeleton-shine) 50%, transparent 100%);
  background-size: 200% 100%;
  background-repeat: no-repeat;
  border-radius: 0.5rem;
  animation: shimmer 1.6s ease-in-out infinite;
}
@utility pt-safe { padding-top: env(safe-area-inset-top, 0px); }
@utility pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }
@utility px-safe {
  padding-left: env(safe-area-inset-left, 0px);
  padding-right: env(safe-area-inset-right, 0px);
}
@utility surface-card {
  background-color: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  box-shadow: var(--elevation-card);
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.page-enter { opacity: 0; transform: translateY(8px); }
.page-enter-active {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .skeleton { animation: none; }
  .page-enter, .page-enter-active { opacity: 1; transform: none; }
}
@media (forced-colors: active) {
  :focus-visible { outline: 2px solid Highlight; }
}
@media print {
  html, body { background: #fff !important; color: #000 !important; }
  .no-print { display: none !important; }
}
