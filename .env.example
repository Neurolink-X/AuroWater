# Copy to .env.local and replace placeholders with real credentials.
# NEVER commit .env.local or real secrets to GitHub.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps / Geocoding
# Server-side only. NEVER use NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_API_KEY=

# Official AuroTap social profiles shown in the public footer.
# Set ONLY real verified AuroTap accounts in production Vercel environment.
# Never use generic https://instagram.com or https://facebook.com homepages.
# All fields are optional; absent profiles are hidden.
NEXT_PUBLIC_AUROTAP_INSTAGRAM_URL=
NEXT_PUBLIC_AUROTAP_FACEBOOK_URL=
NEXT_PUBLIC_AUROTAP_LINKEDIN_URL=
NEXT_PUBLIC_AUROTAP_YOUTUBE_URL=
